{
  "name": "kiri",
  "productName": "kiri",
  "private": true,
  "version": "0.1.4",
  "main": "src/desktop/main.mjs",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "build:cli": "node scripts/build-cli.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:server && pnpm lint:routes && pnpm lint:harness && pnpm lint:scripts",
    "lint:server": "eslint src/server/codex-app-server.ts tests/server/**/*.ts --max-warnings=0",
    "lint:routes": "eslint src/routes/__root.tsx src/routes/landing.tsx --max-warnings=0",
    "lint:harness": "eslint tests/harness/**/*.ts --max-warnings=0",
    "lint:scripts": "node --check scripts/*.mjs",
    "test": "pnpm test:unit && pnpm test:perf",
    "test:unit": "vitest run --exclude tests/server/perf-gates.test.ts",
    "test:perf": "vitest run tests/server/perf-gates.test.ts --no-file-parallelism --maxWorkers=1",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "knip:report": "pnpm exec knip --no-exit-code --reporter compact",
    "verify:knip": "pnpm exec knip --reporter compact",
    "verify:e2e": "pnpm test:e2e --project=chromium",
    "verify:desktop:smoke": "node --check scripts/*.mjs && pnpm build:cli",
    "verify:desktop:package": "pnpm build && pnpm build:cli && node -e \"for (const path of ['dist/mac','dist/mac-arm64','dist/mac-universal']) require('node:fs').rmSync(path, { recursive: true, force: true })\" && electron-builder --mac dir && KIRI_ASSERT_PACKAGED_APP=1 pnpm exec vitest run tests/server/desktop-package-contract.test.ts tests/server/kiri-mcp.test.ts",
    "verify:desktop": "pnpm verify:desktop:smoke && pnpm verify:desktop:package",
    "verify": "pnpm typecheck && pnpm lint && pnpm effect:audit && pnpm test && pnpm knip:report",
    "desktop:dev": "KIRI_DESKTOP_DEV_URL=http://127.0.0.1:3090 electron src/desktop/main.mjs",
    "desktop:start": "pnpm build && electron src/desktop/main.mjs",
    "desktop:backend": "node scripts/kiri-desktop-backend.mjs",
    "dist:desktop": "pnpm build && pnpm build:cli && electron-builder --mac dir && node scripts/normalize-desktop-app.mjs && node scripts/create-desktop-dmg.mjs",
    "install:desktop": "pnpm dist:desktop && node scripts/install-desktop-app.mjs",
    "prepare": "effect-language-service patch",
    "kiri": "tsx src/cli/kirictl.ts",
    "kiricli": "tsx src/cli/kirictl.ts",
    "kiri:ctl": "tsx src/cli/kirictl.ts",
    "kiri:agent-harness": "tsx tests/harness/kiri-agent-cli-harness.ts",
    "kiri:history-harness": "tsx tests/harness/kiri-agent-detail-history-harness.ts",
    "kiri:models": "node scripts/sync-models-dev.mjs",
    "kiri:projects": "tsx src/cli/kirictl.ts projects",
    "effect:audit": "node scripts/effect-migration-audit.mjs",
    "preview": "vite preview",
    "start": "pnpx srvx --prod -s ../client dist/server/server.js"
  },
  "dependencies": {
    "@effect/cli": "^0.75.1",
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.106.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@pierre/diffs": "1.1.21",
    "@pierre/trees": "^1.0.0-beta.3",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-router-ssr-query": "^1.166.12",
    "@tanstack/react-start": "^1.167.65",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "effect": "^3.21.2",
    "lucide-react": "^1.14.0",
    "node-pty": "1.2.0-beta.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "3.23.0",
    "srvx": "0.11.15",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "dev.kiri.desktop",
    "productName": "kiri",
    "files": [
      "dist/client/**",
      "dist/server/**",
      "dist/cli/**",
      "src/desktop/**",
      "scripts/kiri-desktop-backend.mjs",
      "settings.json",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "resources/bin/kiri-mcp",
        "to": "bin/kiri-mcp"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "executableName": "kiri",
      "target": [
        "dmg"
      ]
    }
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@effect/vitest": "^0.29.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "41.5.0",
    "electron-builder": "26.0.12",
    "esbuild": "0.27.7",
    "eslint": "^10.3.0",
    "knip": "6.14.0",
    "tailwindcss": "^4.2.2",
    "tsx": "4.20.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
