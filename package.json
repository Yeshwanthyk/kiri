{
  "name": "kiri",
  "productName": "kiri",
  "private": true,
  "version": "0.1.3",
  "main": "src/desktop/main.mjs",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "build:cli": "node scripts/build-cli.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/server/codex-app-server.ts tests/server/**/*.ts --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "desktop:dev": "KIRI_DESKTOP_DEV_URL=http://127.0.0.1:3090 electron src/desktop/main.mjs",
    "desktop:start": "pnpm build && electron src/desktop/main.mjs",
    "desktop:backend": "node scripts/kiri-desktop-backend.mjs",
    "dist:desktop": "pnpm build && pnpm build:cli && electron-builder --mac dir && node scripts/normalize-desktop-app.mjs && node scripts/create-desktop-dmg.mjs",
    "install:desktop": "pnpm dist:desktop && node scripts/install-desktop-app.mjs",
    "prepare": "effect-language-service patch",
    "kiri": "tsx src/cli/kirictl.ts",
    "kiricli": "tsx src/cli/kirictl.ts",
    "kiri:ctl": "tsx src/cli/kirictl.ts",
    "kiri:agent-harness": "tsx tests/harness/kiri-agent-cli-harness.ts",
    "kiri:history-harness": "tsx tests/harness/kiri-agent-detail-history-harness.ts",
    "kiri:models": "node scripts/sync-models-dev.mjs",
    "kiri:projects": "tsx src/cli/kirictl.ts projects",
    "preview": "vite preview",
    "start": "pnpx srvx --prod -s ../client dist/server/server.js"
  },
  "knip": {
    "entry": [
      "src/desktop/preload.cjs",
      "scripts/kiri-projects.mjs",
      "tests/harness/task-progress-db-harness.ts"
    ]
  },
  "reactDoctor": {
    "entryFiles": [
      "src/desktop/preload.cjs",
      "scripts/kiri-projects.mjs",
      "tests/harness/task-progress-db-harness.ts"
    ],
    "ignore": {
      "overrides": [
        {
          "files": [
            "src/components/KiriBoard.tsx"
          ],
          "rules": [
            "react/no-danger",
            "react-doctor/no-mirror-prop-effect",
            "react-doctor/no-effect-chain",
            "react-doctor/prefer-useReducer",
            "react-doctor/no-giant-component",
            "react-doctor/no-derived-useState",
            "react-doctor/no-derived-state-effect",
            "react-doctor/no-cascading-set-state",
            "react-doctor/no-effect-event-handler",
            "react-doctor/no-prop-callback-in-effect"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@effect/cli": "^0.75.1",
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.106.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@pierre/diffs": "1.1.21",
    "@pierre/trees": "^1.0.0-beta.3",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-query-devtools": "^5.90.0",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-router-ssr-query": "^1.166.12",
    "@tanstack/react-start": "^1.167.65",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "effect": "^3.21.2",
    "fast-check": "3.23.2",
    "lucide-react": "^1.14.0",
    "node-pty": "1.2.0-beta.12",
    "pure-rand": "6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "redaxios": "^0.5.1",
    "remark-gfm": "^4.0.1",
    "srvx": "0.11.15",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "dev.kiri.desktop",
    "productName": "kiri",
    "files": [
      "dist/client/**",
      "dist/server/**",
      "dist/cli/**",
      "src/desktop/**",
      "scripts/kiri-desktop-backend.mjs",
      "scripts/create-desktop-dmg.mjs",
      "scripts/normalize-desktop-app.mjs",
      "settings.json",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "resources/bin/kiri-mcp",
        "to": "bin/kiri-mcp"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "executableName": "kiri",
      "target": [
        "dmg"
      ]
    }
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@effect/vitest": "^0.29.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "41.5.0",
    "electron-builder": "26.0.12",
    "esbuild": "0.27.7",
    "eslint": "^10.3.0",
    "tailwindcss": "^4.2.2",
    "tsx": "4.20.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
