{
  "name": "aether",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/server/codex-app-server.ts tests/server/**/*.ts --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "effect-language-service patch",
    "aether:models": "node scripts/sync-models-dev.mjs",
    "aether:projects": "node scripts/aether-projects.mjs",
    "preview": "vite preview",
    "start": "pnpx srvx --prod -s ../client dist/server/server.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
